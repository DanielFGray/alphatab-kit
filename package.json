{
  "name": "alphatab-kit",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Shared alphaTab customizations: Vite plugin, patches and React player parts.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "default": "./dist/vite.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./render": {
      "types": "./dist/render.d.ts",
      "default": "./dist/render.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "prepare": "effect-tsgo patch --typescript --oxlint",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "lint": "oxlint --type-aware"
  },
  "peerDependencies": {
    "@coderline/alphatab": "*",
    "react": "^19.0.0",
    "vite": ">=6",
    "effect": "^4.1.0"
  },
  "devDependencies": {
    "@coderline/alphatab": "1.9.0-alpha.1891",
    "@effect/tsgo": "0.67.7",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.2.0",
    "@types/react": "^19.3.0",
    "effect": "4.1.2",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2006",
    "react": "^19.3.1",
    "typescript": "7.0.2",
    "vite": "^8.1.5"
  },
  "files": [
    "dist",
    "patches"
  ],
  "bin": {
    "alphatab-kit": "./dist/bin.js"
  },
  "peerDependenciesMeta": {
    "effect": {
      "optional": true
    }
  }
}
